{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".*", "**/node_modules/**", "functions/**", "tests/**", "package*.json", "playwright*.config.js", "README.md", "database.rules.json", "*-debug.log", "test-results/**", "playwright-report/**"],
    "headers": [{ "source": "**", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] }]
  },
  "emulators": { "auth": { "port": 9099 }, "database": { "port": 9000 }, "hosting": { "port": 8080 }, "ui": { "enabled": true } }
}